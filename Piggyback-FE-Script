--[[
    [FE] Simple Piggyback System - Server Sided Visibility
    Executor: Delta (Mobile/Android)
    Logic: Uses standard Sit for server replication and Heartbeat for position.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local CONFIG = {
    HighlightColor = Color3.fromRGB(0, 255, 127),
    HighlightOutline = Color3.fromRGB(255, 255, 255),
    RideOffset = CFrame.new(0, 1.4, 0.8), -- Twoja wysokość (+0.2)
    MaxClickDistance = 150,
    SitDistance = 15,
    ButtonColor = Color3.fromRGB(255, 50, 50)
}

local Piggyback = {
    Target = nil,
    IsRiding = false,
    SelectionState = 0,
    Connections = {},
    Visuals = {}
}

function Piggyback:Cleanup()
    for _, conn in pairs(self.Connections) do conn:Disconnect() end
    self.Connections = {}
    
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then 
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end

    if self.UI then self.UI:Destroy() end
    self.IsRiding = false
end

function Piggyback:Attach()
    if not self.Target or not self.Target.Character then return end
    self.IsRiding = true
    self.SelectionState = 0
    
    if self.HighlightObj then self.HighlightObj:Destroy() end
    
    local char = LocalPlayer.Character
    local tChar = self.Target.Character
    local hum = char:WaitForChild("Humanoid")
    
    -- Wyłączenie kolizji, aby nie glitchować gracza
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    -- Pętla wymuszająca pozycję i stan siedzenia (Replikacja FE)
    local rideLoop = RunService.Heartbeat:Connect(function()
        if not self.IsRiding or not tChar or not tChar:FindFirstChild("HumanoidRootPart") then
            self:Cleanup()
            return
        end
        
        -- Wymuszamy stan siedzenia (serwer to widzi)
        hum.Sit = true
        
        -- Twarde ustawienie pozycji (serwer to widzi dzięki NetworkOwnership)
        char:PivotTo(tChar.HumanoidRootPart.CFrame * CONFIG.RideOffset)
    end)
    table.insert(self.Connections, rideLoop)
    
    self:CreateUI()
end

function Piggyback:CreateUI()
    local gui = Instance.new("ScreenGui", CoreGui)
    self.UI = gui
    local btn = Instance.new("TextButton", gui)
    btn.Size = UDim2.new(0, 120, 0, 50)
    btn.Position = UDim2.new(1, -140, 1, -200)
    btn.BackgroundColor3 = CONFIG.ButtonColor
    btn.Text = "ZEJDŹ"
    btn.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(function() self:Cleanup() end)
end

function Piggyback:Init()
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            if self.IsRiding then return end
            
            local ray = Camera:ScreenPointToRay(input.Position.X, input.Position.Y)
            local result = Workspace:Raycast(ray.Origin, ray.Direction * CONFIG.MaxClickDistance)
            local model = result and result.Instance:FindFirstAncestorOfClass("Model")
            local p = model and Players:GetPlayerFromCharacter(model)
            
            if p and p ~= LocalPlayer then
                if self.Target == p and self.SelectionState == 1 then
                    local dist = (LocalPlayer.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if dist <= CONFIG.SitDistance then self:Attach() end
                else
                    self.Target = p
                    self.SelectionState = 1
                    if self.HighlightObj then self.HighlightObj:Destroy() end
                    local hl = Instance.new("Highlight", CoreGui)
                    hl.Adornee = p.Character
                    hl.FillColor = CONFIG.HighlightColor
                    self.HighlightObj = hl
                end
            else
                self.Target = nil
                self.SelectionState = 0
                if self.HighlightObj then self.HighlightObj:Destroy() end
            end
        end
    end)
end

Piggyback:Init()
